{
  "name": "bb-plugin-nested-sidebar",
  "version": "0.1.1",
  "description": "A group-first sidebar: project groups, worktree-aware thread trees, and activity that bubbles up.",
  "license": "MIT",
  "author": "verger (fork of Dockside by Mateo Cerquetella)",
  "private": true,
  "keywords": [
    "bb",
    "bb-plugin",
    "sidebar",
    "nest",
    "projects",
    "threads",
    "snooze"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "bb": ">=0.36",
    "bbPluginSdk": ">=0.4.84"
  },
  "bb": {
    "name": "Nest",
    "description": "A group-first sidebar: project groups, worktree-aware thread trees, and activity that bubbles up.",
    "branding": {
      "icon": "./assets/icon.svg",
      "logo": {
        "light": "./assets/logo.svg",
        "dark": "./assets/logo-dark.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": []
  },
  "files": [
    "dist/server.js",
    "dist/server.meta.json",
    "dist/app.js",
    "dist/app.meta.json",
    "dist/app.css",
    "assets/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "server.ts",
    "app.tsx",
    "lib/",
    "components/",
    "hooks/"
  ],
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.1.3",
    "@hugeicons/react": "^1.1.6",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-hover-card": "^1.1.23",
    "@radix-ui/react-select": "^2.3.3",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.4.84",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "hono": "^4.11.9",
    "typescript": "^7.0.0"
  },
  "scripts": {
    "dev": "bb plugin dev .",
    "build": "bb plugin build .",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "clean": "rm -rf dist"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
